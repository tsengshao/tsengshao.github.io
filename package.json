{
  "name": "shaoyu-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "validate:content": "node scripts/validate-content.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "cv:pdf": "node scripts/render-cv-pdfs.mjs",
    "predev": "node scripts/gen-site-meta.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/gen-site-meta.mjs",
    "build": "npm run validate:content && npm run cv:pdf && astro build",
    "check": "astro check",
    "check:links": "node scripts/check-dist-links.mjs",
    "verify": "npm run check && npm run build && npm run check:links",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.3",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.3.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  }
}
