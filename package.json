    "astro": "astro"
  },
  "dependencies": {
    "astro": "^5.16.11"
  },
  "devDependencies": {
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1"
  }
}
