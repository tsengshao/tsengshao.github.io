---
import { withBase } from "../lib/urls";

const navigation = [
  { href: "/#topics", label: "Research" },
  { href: "/publications", label: "Publications" },
  { href: "/cv", label: "CV" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<header class="navbar" role="banner">
  <div class="container">
    <div class="navbar-inner">
      <a class="brand" href={withBase("/")} aria-label="Shao-Yu Tseng — Home">Shao-Yu Tseng</a>
      <nav class="navlinks" aria-label="Primary navigation">
        {navigation.map((item) => {
          const href = withBase(item.href);
          const matchPath = href.split("#")[0].replace(/\/$/, "");
          const active = !item.href.includes("#") && (currentPath === matchPath || currentPath.startsWith(`${matchPath}/`));
          return <a href={href} aria-current={active ? "page" : undefined}>{item.label}</a>;
        })}
      </nav>
    </div>
  </div>
</header>
