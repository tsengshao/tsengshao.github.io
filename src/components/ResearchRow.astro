---
import { isExternalUrl, withBase } from "../lib/urls";

interface MediaItem {
  kind: "image" | "video";
  src: string;
  alt?: string;
  poster?: string;
  label?: string;
  link?: string;
}

interface Props {
  index?: number;
  title: string;
  short?: string;
  summary?: string;
  href?: string;
  cover?: string;
  video?: string;
  media?: MediaItem[];
  fit?: "contain" | "cover";
  ratio?: string;
  autoplay?: boolean;
  showText?: boolean;
}

const {
  index = 0,
  title,
  short,
  summary,
  href,
  cover,
  video,
  media: mediaProp = [],
  fit = "contain",
  ratio = "16/9",
  autoplay = true,
  showText = true,
}: Props = Astro.props;

const reverse = index % 2 === 1;
const legacyMedia: MediaItem[] = [];
if (video) legacyMedia.push({ kind: "video", src: video, alt: title });
if (cover) legacyMedia.push({ kind: "image", src: cover, alt: title });
const rawMedia: MediaItem[] = mediaProp?.length ? mediaProp : legacyMedia;
const media: MediaItem[] = rawMedia.map((item) => ({
  ...item,
  src: withBase(item.src),
  poster: item.poster ? withBase(item.poster) : undefined,
  link: item.link ? withBase(item.link) : undefined,
}));
const labels = media.map((item) => item.label ?? item.alt ?? "");
---

<div
  class={`research-row ${reverse ? "research-row--reverse" : ""} ${showText ? "" : "research-row--media-only"}`}
  data-research-carousel
  data-labels={JSON.stringify(labels)}
>
  {showText && (
    <div class="research-text" style={reverse ? "order:2" : "order:1"}>
      <div class="kicker">Research topic {index + 1}</div>
      <h2 style="margin:0;">{title}</h2>
      {short && <p class="punchline">{short}</p>}
      {summary && <p class="keyline">{summary}</p>}
      {href && <a class="research-more" href={withBase(href)}>Explore this research <span aria-hidden="true">→</span></a>}
    </div>
  )}

  <div class="media-block" style={!showText || reverse ? "order:1" : "order:2"}>
    <div class={`media-frame media-fit-${fit}`} style={`--ratio:${ratio};`}>
      {media.length > 0 ? (
        <div class="rr-track" tabindex="0" aria-label={`${title} media carousel`}>
          {media.map((item, mediaIndex) => (
            <div
              class="rr-slide"
              data-index={String(mediaIndex)}
              role="group"
              aria-label={`${mediaIndex + 1} of ${media.length}: ${item.alt ?? item.label ?? title}`}
            >
              {item.link ? (
                <a
                  class="rr-media-link"
                  href={item.link}
                  target={isExternalUrl(item.link) ? "_blank" : undefined}
                  rel={isExternalUrl(item.link) ? "noreferrer noopener" : undefined}
                  aria-label={`Open ${item.label ?? item.alt ?? title}`}
                >
                  {item.kind === "video" ? (
                    <video
                      src={item.src}
                      poster={item.poster}
                      aria-label={item.alt ?? title}
                      autoplay={autoplay}
                      controls
                      muted
                      loop
                      playsinline
                      preload="metadata"
                    />
                  ) : (
                    <img src={item.src} alt={item.alt ?? title} loading="lazy" />
                  )}
                </a>
              ) : item.kind === "video" ? (
                <video
                  src={item.src}
                  poster={item.poster}
                  aria-label={item.alt ?? title}
                  autoplay={autoplay}
                  controls
                  muted
                  loop
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img src={item.src} alt={item.alt ?? title} loading="lazy" />
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="media-empty">Media for this research topic will be added soon.</div>
      )}
    </div>

    {media.length > 0 && (
      <div class="rr-controls">
        <div class="rr-badge" role="status" aria-live="polite"></div>
        {media.length > 1 && (
          <div class="rr-arrows" aria-label="Carousel controls">
            <button class="rr-arrow" type="button" data-dir="-1" aria-label={`Previous media for ${title}`}>
              <span aria-hidden="true">‹</span>
            </button>
            <button class="rr-arrow" type="button" data-dir="1" aria-label={`Next media for ${title}`}>
              <span aria-hidden="true">›</span>
            </button>
          </div>
        )}
      </div>
    )}
  </div>
</div>

<script>
  const initializeResearchCarousels = () => {
    document
      .querySelectorAll<HTMLElement>("[data-research-carousel]:not([data-carousel-ready])")
      .forEach((root) => {
        root.dataset.carouselReady = "true";

        const track = root.querySelector<HTMLElement>(".rr-track");
        const slides = root.querySelectorAll<HTMLElement>(".rr-slide");
        const previousButton = root.querySelector<HTMLButtonElement>('.rr-arrow[data-dir="-1"]');
        const nextButton = root.querySelector<HTMLButtonElement>('.rr-arrow[data-dir="1"]');
        const badge = root.querySelector<HTMLElement>(".rr-badge");
        if (!track || slides.length === 0) return;

        const labels = JSON.parse(root.dataset.labels || "[]") as string[];
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let active = 0;
        let animationFrame = 0;

        if (reducedMotion) {
          root.querySelectorAll<HTMLVideoElement>("video").forEach((video) => video.pause());
        }

        const update = () => {
          if (previousButton) previousButton.disabled = active === 0;
          if (nextButton) nextButton.disabled = active === slides.length - 1;
          if (badge) {
            badge.textContent = labels[active] || `${active + 1} of ${slides.length}`;
            badge.style.visibility = "visible";
          }
        };

        const scrollToIndex = (index: number) => {
          const target = Math.max(0, Math.min(slides.length - 1, index));
          track.scrollTo({
            left: target * track.clientWidth,
            behavior: reducedMotion ? "auto" : "smooth",
          });
        };

        previousButton?.addEventListener("click", () => scrollToIndex(active - 1));
        nextButton?.addEventListener("click", () => scrollToIndex(active + 1));
        track.addEventListener(
          "scroll",
          () => {
            cancelAnimationFrame(animationFrame);
            animationFrame = requestAnimationFrame(() => {
              active = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1))));
              update();
            });
          },
          { passive: true },
        );

        update();
      });
  };

  initializeResearchCarousels();
</script>
