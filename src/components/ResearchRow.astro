---
const {
  index = 0,
  title,
  short,

  // legacy
  cover,
  video,

  // new: array of media
  // [{ kind:"image"|"video", src:"...", alt?, poster?, caption? }]
  media: mediaProp = [],

  fit = "contain",
  ratio = "16/9",

  autoplay = true,
  interval = 6000,
  debug = false, // 需要 debug 就在 index.astro 傳 debug={true}
} = Astro.props;

const reverse = (index % 2 === 1);
const uid = `rr-${index}`;

// normalize media: prefer media[]; fallback to legacy
const media =
  (mediaProp?.length ? mediaProp : [
    ...(video ? [{ kind: "video", src: video }] : []),
    ...(cover ? [{ kind: "image", src: cover, alt: title }] : []),
  ]);
---

<div id={uid} class={`research-row ${reverse ? "research-row--reverse" : ""}`}>
  <div class="research-text" style={reverse ? "order:2" : "order:1"}>
    <div class="kicker">Research topic {index + 1}</div>
    <h2 style="margin:0;">{title}</h2>
    <p class="keyline">{short}</p>
  </div>

  <div class="media-block" style={reverse ? "order:1" : "order:2"}>
    <div
      class={`media-frame media-fit-${fit}`}
      style={`--ratio:${ratio};`}
      data-autoplay={autoplay ? "1" : "0"}
      data-interval={String(interval)}
      data-debug={debug ? "1" : "0"}
    >
      {media.length > 0 ? (
          <div class="rr-track" tabindex="0" aria-label="Project media carousel">
            {media.map((m, i) => (
              <div class="rr-slide" data-index={String(i)}>
                {m.kind === "video" ? (
                  <video
                    src={m.src}
                    poster={m.poster}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <img src={m.src} alt={m.alt ?? title} loading="lazy" />
                )}
              </div>
            ))}
          </div>
  
      ) : (
        <div style="padding: 16px; color: var(--muted);">
          This project has no media yet. Add <code>media</code> (or legacy <code>cover/video</code>) in frontmatter.
        </div>
      )}
    </div>

   
    {media.length > 1 && (
      <div class="rr-controls">
        <div class="rr-badge" aria-hidden="true"></div>
      
        <div class="rr-arrows" aria-label="carousel controls">
              <button class="rr-arrow" type="button" data-dir="-1" aria-label="Prev">‹</button>
              <button class="rr-arrow" type="button" data-dir="1" aria-label="Next">›</button>
        </div>
      </div>

    )}
  </div>
</div>

<script
  is:inline
  define:vars={{
    uid,
    labels: media.map(m => (m.label ?? "")),
  }}
>
(() => {
  /* ================= DEBUG ================= */
  const DEBUG = false; // ← 要看 log 再改 true
  const log = (...args) => DEBUG && console.log("[ResearchRow]", ...args);

  /* ================= DOM ================= */
  const root = document.getElementById(uid);
  if (!root) return;

  const track   = root.querySelector(".rr-track");
  const slides  = root.querySelectorAll(".rr-slide");
  const prevBtn = root.querySelector('.rr-arrow[data-dir="-1"]');
  const nextBtn = root.querySelector('.rr-arrow[data-dir="1"]');
  const badge   = root.querySelector(".rr-badge");

  if (!track || !slides.length) return;

  const total = slides.length;
  let active = 0;

  /* ================= TUNING ================= */
  const ARROW_DURATION_MS = 1000; // 慢一點、有慣性

  // 等速段比例：0.55~0.8 都可以試
  const LINEAR_PORTION = 0.50;
  
  /** cos 減速（0→1，尾端斜率=0，很滑順） */
  const cosEase = (u) => Math.pow( 0.5 * (1 - Math.cos(Math.PI * u)), 0.25);
  
  /**
   * 先等速（最大速度）到 LINEAR_PORTION，
   * 再用 cosEase 把剩下的距離收尾減速到 0。
   * const easeLinearThenCos = (t) => {
   */
  const easeMacTrackpad = (t) => {
    const k = LINEAR_PORTION;
    if (t <= k) return t; // 等速（最大速度）
    const u = (t - k) / (1 - k); // 尾段 0..1
    return k + (1 - k) * cosEase(u);
  };


  /* ================= HELPERS ================= */
  const clamp = (v, min, max) => Math.max(min, Math.min(max, v));

  const updateButtons = () => {
    if (prevBtn) prevBtn.disabled = active <= 0;
    if (nextBtn) nextBtn.disabled = active >= total - 1;
  };

  const updateBadge = (idx) => {
    if (!badge) return;
    const text = labels[idx] ? String(labels[idx]).trim() : "";
    badge.textContent = text;
    badge.style.visibility = text ? "visible" : "hidden";
    log("badge →", idx, text);
  };

  /* ================= ARROW ANIMATION ================= */
  let animId = 0;
  const animateTo = (targetLeft, durationMs) => {
    animId++;
    const myId = animId;

    const startLeft = track.scrollLeft;
    const delta = targetLeft - startLeft;
    if (Math.abs(delta) < 1) return Promise.resolve();

    return new Promise((resolve) => {
      const t0 = performance.now();

      const step = (now) => {
        if (myId !== animId) return;
        const t = Math.min(1, (now - t0) / durationMs);
        track.scrollLeft = startLeft + delta * easeMacTrackpad(t);
        if (t < 1) requestAnimationFrame(step);
        else resolve();
      };

      requestAnimationFrame(step);
    });
  };

  const scrollToIndex = (i) => {
    const w = track.clientWidth || 1;
    const target = clamp(i, 0, total - 1);
    const left = target * w;
    log("arrow →", target);
    animateTo(left, ARROW_DURATION_MS);
  };

  /* ================= EVENTS ================= */
  if (prevBtn) {
    prevBtn.addEventListener("click", (e) => {
      e.preventDefault();
      scrollToIndex(active - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", (e) => {
      e.preventDefault();
      scrollToIndex(active + 1);
    });
  }

  // scroll = 唯一真相來源（滾輪 & 箭頭共用）
  let raf = 0;
  track.addEventListener(
    "scroll",
    () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const w = track.clientWidth || 1;
        const next = clamp(Math.round(track.scrollLeft / w), 0, total - 1);
        if (next === active) return;
        active = next;
        log("scroll → active", active);
        updateButtons();
        updateBadge(active);
      });
    },
    { passive: true }
  );

  /* ================= INIT ================= */
  updateButtons();
  updateBadge(active);
})();
</script>
