---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getCollection } from "astro:content";
import { splitPublications } from "../lib/publications";
import { siteProfile } from "../data/site";
import { withBase } from "../lib/urls";

const positions = (await getCollection("positions"))
  .sort((a, b) => b.data.start.localeCompare(a.data.start));
const honors = (await getCollection("honors"))
  .sort((a, b) => b.data.year - a.data.year);
const publications = await getCollection("publications");
const { all: allPublications } = splitPublications(publications);
---

<BaseLayout
  title="CV"
  description={siteProfile.description}
>
  <section class="section">
    <div class="container">
      <div class="cv-layout">
        <aside class="cv-sidebar">
          <div class="eyebrow">Curriculum Vitae</div>
          <h1>{siteProfile.name}</h1>
          <p class="punchline hero-punch">{siteProfile.role}</p>
          <p class="feature-copy">{siteProfile.affiliation} · {siteProfile.location}</p>
          <div class="button-row">
            <a class="btn" href={withBase("/cv.pdf")} target="_blank" rel="noreferrer noopener">Download PDF</a>
            <a class="btn btn-ghost" href={withBase("/publications")}>View Publications</a>
          </div>

          <div class="cv-notes">
            {siteProfile.cvSummary.map((item) => (
              <p>{item}</p>
            ))}
          </div>
        </aside>

        <div class="cv-main">
          <SectionHeader
            title="Curriculum Vitae"
            subtitle="A concise screen-readable CV with the same research emphasis as the rest of the site: clear structure, restrained styling, and publication output in APA format."
          />

          <section class="cv-section">
            <h2>Positions</h2>
            <div class="stack-list">
              {positions.map((position) => (
                <article class="cv-entry">
                  <div class="cv-entry-meta">{position.data.start} - {position.data.end}</div>
                  <div>
                    <h3>{position.data.role}</h3>
                    <p class="feature-copy">
                      {position.data.org}
                      {position.data.location ? ` · ${position.data.location}` : ""}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="cv-section">
            <h2>Honors & Awards</h2>
            <div class="stack-list">
              {honors.map((honor) => (
                <article class="cv-entry">
                  <div class="cv-entry-meta">{honor.data.year}</div>
                  <div>
                    <h3>{honor.data.title}</h3>
                    {honor.data.org && <p class="feature-copy">{honor.data.org}</p>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="cv-section">
            <h2>Publications</h2>
            <ul class="pub-list pub-list--bullets pub-list--featured">
              {allPublications.map((pub) => (
                <li class="pub-item pub-item--bullet">
                  <PublicationEntry pub={pub} showStatus />
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
