---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchRow from "../components/ResearchRow.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a,b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 2);

const topic1 = projects[0];
const topic2 = projects[1];
---

<BaseLayout title="Shao-Yu Tseng">
  <!-- 1) Name + Intro (white) -->
  <section class="section">
    <div class="container">
      <div class="prose">
        <h1>Shao-Yu Tseng</h1>
        <p class="punchline">
          Understanding how convection couples with circulation across scales — from idealized simulations to GSRMs.
        </p>
        <p class="lead">
          I focus on understanding convective processes across scales, from convective organization to the coupling between convective clusters and circulation.
Using a cloud-resolving model (VVM), I investigate the physical mechanisms governing these processes, and apply quantitative, process-oriented diagnostics to evaluate global storm-resolving models against high-resolution observations, with the aim of identifying the physical origins of model biases and providing guidance for model improvement.
While my current publications address different aspects of these processes, my long-term goal is to integrate insights from idealized experiments and quantitative model diagnostics into a unified physical framework.
        </p>
        <p class="lead">
          I am currently a PhD student in the Department of Atmospheric Sciences at National Taiwan University, advised by Prof. Wei-Ting Chen, with Prof. Chien-Ming Wu as co-advisor.
        </p>

        <div style="margin-top:18px; display:flex; gap:12px; flex-wrap:wrap; color: var(--muted); font-size: 14px;">
          {/*<span>Department of Atmospheric Sciences, NTU</span>*}
          {/*<span>•</span>*/}
          <a href="#" title="add email later">Email</a>
          <span>•</span>
          <a href="#" target="_blank">ORCID</a>
          <span>•</span>
          <a href="#" target="_blank">Google Scholar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2) Topic 1 (alt) -->
  <section class="section section--alt">
    <div class="container">
      {topic1 ? (
        <ResearchRow
          index={0}
          title={topic1.data.title}
          short={topic1.data.short}
          summary={topic1.data.summary}
          media={topic1.data.media}
          cover={topic1.data.cover}
          video={topic1.data.video}
          fit={topic1.data.fit}
          ratio={topic1.data.ratio}
        />
      ) : (
        <p class="lead">Add your first project in <code>src/content/projects/</code>.</p>
      )}
    </div>
  </section>

  <!-- 3) Topic 2 (white) -->
  <section class="section">
    <div class="container">
      {topic2 ? (
        <ResearchRow
          index={1}
          title={topic2.data.title}
          short={topic2.data.short}
          summary={topic2.data.summary}
          media={topic2.data.media}
          cover={topic2.data.cover}
          video={topic2.data.video}
          fit={topic2.data.fit}
          ratio={topic2.data.ratio}
        />
      ) : (
        <p class="lead">Add your second project in <code>src/content/projects/</code>.</p>
      )}
    </div>
  </section>
</BaseLayout>
