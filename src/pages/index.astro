---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSchematic from "../components/HeroSchematic.astro";
import ResearchRow from "../components/ResearchRow.astro";
import { siteProfile } from "../data/site";
import { withBase } from "../lib/urls";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const contactLinks = [
  siteProfile.contacts.email && { label: "Email", href: `mailto:${siteProfile.contacts.email}`, external: false },
  { label: "CV", href: withBase("/downloads/Shao-Yu-Tseng-CV.pdf"), external: false, download: true },
].filter(Boolean) as Array<{ label: string; href: string; external: boolean; download?: boolean }>;
---

<BaseLayout title={siteProfile.name} description={siteProfile.description}>
  <section class="section home-hero">
    <div class="container">
      <div class="home-hero-copy">
        <h1>{siteProfile.name}</h1>
        <p class="punchline">{siteProfile.headline}</p>
        <div class="home-hero-intro">
          <p class="lead">{siteProfile.intro}</p>
          <p class="lead">
            I am a Ph.D. candidate in the Department of Atmospheric Sciences at National Taiwan University,
            advised by Prof. Wei-Ting Chen and co-advised by Prof. Chien-Ming Wu.
          </p>
        </div>

        <div class="profile-links" aria-label="Academic profiles and contact">
          {contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer noopener" : undefined}
              download={link.download ? "Shao-Yu-Tseng-CV.pdf" : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <HeroSchematic />
    </div>
  </section>

  {projects.map((project, index) => (
    <section id={index === 0 ? "topics" : undefined} class={`section section-anchor ${index % 2 === 0 ? "section--alt" : ""}`}>
      <div class="container">
        {index === 0 && (
          <header class="topic-heading">
            <h2>Research topics</h2>
          </header>
        )}
        <ResearchRow
          index={index}
          title={project.data.title}
          short={project.data.short}
          summary={project.data.summary}
          media={project.data.media}
          cover={project.data.cover}
          video={project.data.video}
          fit={project.data.fit}
          ratio={project.data.ratio}
        />
      </div>
    </section>
  ))}
</BaseLayout>
