---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchRow from "../components/ResearchRow.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .sort((a,b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 2);

const topic1 = projects[0];
const topic2 = projects[1];
---

<BaseLayout title="Shao-Yu Tseng">
  <!-- 1) Name + Intro (white) -->
  <section class="section">
    <div class="container">
      <div class="prose">
        <h1>Shao-Yu Tseng</h1>
        <p class="lead">
          I study convective organization and circulation coupling for tropical cyclone seed genesis,
          and physics-based evaluation of global storm-resolving models over ocean and complex terrain.
        </p>

        <div style="margin-top:18px; display:flex; gap:12px; flex-wrap:wrap; color: var(--muted); font-size: 14px;">
          <span>Department of Atmospheric Sciences, NTU</span>
          <span>•</span>
          <a href="#" title="add email later">Email</a>
          <span>•</span>
          <a href="#" target="_blank">ORCID</a>
          <span>•</span>
          <a href="#" target="_blank">Google Scholar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2) Topic 1 (alt) -->
  <section class="section section--alt">
    <div class="container">
      {topic1 ? (
        <ResearchRow
          index={0}
          title={topic1.data.title}
          short={topic1.data.short}
          media={topic1.data.media}
          cover={topic1.data.cover}
          video={topic1.data.video}
          fit={topic1.data.fit}
          ratio={topic1.data.ratio}
        />
      ) : (
        <p class="lead">Add your first project in <code>src/content/projects/</code>.</p>
      )}
    </div>
  </section>

  <!-- 3) Topic 2 (white) -->
  <section class="section">
    <div class="container">
      {topic2 ? (
        <ResearchRow
          index={1}
          title={topic2.data.title}
          short={topic2.data.short}
          media={topic2.data.media}
          cover={topic2.data.cover}
          video={topic2.data.video}
          fit={topic2.data.fit}
          ratio={topic2.data.ratio}
        />
      ) : (
        <p class="lead">Add your second project in <code>src/content/projects/</code>.</p>
      )}
    </div>
  </section>
</BaseLayout>
