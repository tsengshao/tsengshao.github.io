---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchRow from "../components/ResearchRow.astro";
import { siteProfile } from "../data/site";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const contactLinks = [
  siteProfile.contacts.email && { label: "Email", href: `mailto:${siteProfile.contacts.email}`, external: false },
  siteProfile.contacts.orcid && { label: "ORCID", href: siteProfile.contacts.orcid, external: true },
  siteProfile.contacts.scholar && { label: "Google Scholar", href: siteProfile.contacts.scholar, external: true },
].filter(Boolean) as Array<{ label: string; href: string; external: boolean }>;
---

<BaseLayout title={siteProfile.name} description={siteProfile.description}>
  <section class="section">
    <div class="container">
      <div class="prose">
        <h1>{siteProfile.name}</h1>
        <p class="punchline">{siteProfile.headline}</p>
        <p class="lead">{siteProfile.intro}</p>
        <p class="lead">{siteProfile.statement}</p>
        <p class="lead">
          I am a Ph.D. candidate in the Department of Atmospheric Sciences at National Taiwan University,
          advised by Prof. Wei-Ting Chen and co-advised by Prof. Chien-Ming Wu.
        </p>

        <div class="profile-links" aria-label="Academic profiles and contact">
          {contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer noopener" : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {projects.map((project, index) => (
    <section class={`section ${index % 2 === 0 ? "section--alt" : ""}`}>
      <div class="container">
        <ResearchRow
          index={index}
          title={project.data.title}
          short={project.data.short}
          summary={project.data.summary}
          media={project.data.media}
          cover={project.data.cover}
          video={project.data.video}
          fit={project.data.fit}
          ratio={project.data.ratio}
          href={`/research/${project.id}`}
        />
      </div>
    </section>
  ))}
</BaseLayout>
