---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { siteProfile } from "../data/site";
import { splitPublications, type PublicationEntry as Publication } from "../lib/publications";

const publications = await getCollection("publications");
const {
  all,
  preprints,
  submitted,
  inReview,
  accepted,
  published,
  publishedRows,
} = splitPublications(publications);

const workingGroups: Array<{ title: string; description: string; items: Publication[] }> = [
  {
    title: "Preprints",
    description: "Publicly available manuscripts that have not yet completed peer review.",
    items: preprints,
  },
  {
    title: "Under Review",
    description: "Manuscripts currently in peer review.",
    items: inReview,
  },
  {
    title: "Submitted",
    description: "Manuscripts submitted to a journal and awaiting review status.",
    items: submitted,
  },
  {
    title: "Accepted",
    description: "Peer-reviewed work accepted for publication and awaiting final bibliographic details.",
    items: accepted,
  },
].filter((group) => group.items.length > 0);
---

<BaseLayout title="Publications" description={`Publications by ${siteProfile.name} on convection, circulation, and storm-resolving models.`}>
  <section class="section">
    <div class="container">
      <div class="prose">
        <div class="eyebrow">Research Output</div>
        <h1>Publications</h1>
        <p class="lead">
          Peer-reviewed articles and preprints on convection–circulation coupling, idealized cloud-resolving simulations,
          and process-oriented evaluation of global storm-resolving models.
        </p>
        <p class="publication-overview">
          {all.length} research {all.length === 1 ? "output" : "outputs"} · {published.length} published · {preprints.length} {preprints.length === 1 ? "preprint" : "preprints"}
        </p>
      </div>

      {workingGroups.map((group, index) => (
        <>
          {index > 0 && <hr class="pub-sep" />}
          <section class="pub-block" aria-labelledby={`publication-group-${index}`}>
            <h2 id={`publication-group-${index}`} class="pub-block-title">{group.title}</h2>
            <p class="pub-block-description">{group.description}</p>
            <ul class="pub-list pub-list--bullets">
              {group.items.map((pub) => (
                <li class="pub-item pub-item--bullet"><PublicationEntry pub={pub} /></li>
              ))}
            </ul>
          </section>
        </>
      ))}

      {published.length > 0 && (
        <>
          {workingGroups.length > 0 && <hr class="pub-sep" />}
          <section class="pub-block" aria-labelledby="published-publications">
            <h2 id="published-publications" class="pub-block-title">Published</h2>
            <ol class="pub-list pub-list--revnum">
              {publishedRows.map((row) =>
                row.kind === "year" ? (
                  <li class="pub-year">{row.year}</li>
                ) : (
                  <li class="pub-item pub-item--num">
                    <span class="pub-num" aria-hidden="true">{row.num}.</span>
                    <PublicationEntry pub={row.pub} />
                  </li>
                )
              )}
            </ol>
          </section>
        </>
      )}

      {all.length === 0 && <p class="lead">Publication records will be added here.</p>}
    </div>
  </section>
</BaseLayout>
