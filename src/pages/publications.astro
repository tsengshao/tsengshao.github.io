---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getCollection } from "astro:content";

const pubs = await getCollection("publications");

const byYear = pubs
  .sort((a, b) => b.data.year - a.data.year)
  .reduce((acc, p) => {
    const y = p.data.year;
    acc[y] = acc[y] || [];
    acc[y].push(p);
    return acc;
  }, /** @type {Record<number, typeof pubs>} */ ({}));
---

<BaseLayout title="Publications">
  <section class="section">
    <div class="container">
      <div class="prose">
        <SectionHeader
          title="Publications"
          subtitle="Grouped by year for fast scanning. (Scholar/ORCID links can be added later.)"
        />
      </div>

      <div style="margin-top: 18px;">
        {Object.entries(byYear).map(([year, list]) => (
          <div style="margin: 26px 0;">
            <div style="font-size: 18px; font-weight: 850; margin-bottom: 10px;">
              {year}
            </div>

            <div style="display:flex; flex-direction:column;">
              {list.map((p) => (
                <div style="padding: 12px 0; border-bottom: 1px solid rgba(15,23,42,.10);">
                  <div style="font-weight: 850; line-height: 1.25;">
                    {p.data.title}
                  </div>

                  <div style="color: var(--muted); margin-top: 6px; line-height: 1.45;">
                    {p.data.authors}{p.data.venue ? ` • ${p.data.venue}` : ""}
                  </div>

                  <div style="margin-top: 10px; display:flex; gap: 10px; flex-wrap: wrap;">
                    {p.data.links?.pdf && <a class="btn" href={p.data.links.pdf} target="_blank">PDF</a>}
                    {p.data.links?.doi && <a class="btn" href={p.data.links.doi} target="_blank">DOI</a>}
                    {p.data.links?.arxiv && <a class="btn" href={p.data.links.arxiv} target="_blank">arXiv</a>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
