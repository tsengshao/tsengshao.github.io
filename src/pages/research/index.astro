---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchRow from "../../components/ResearchRow.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getCollection } from "astro:content";
import { siteProfile } from "../../data/site";

const projects = (await getCollection("projects"))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<BaseLayout
  title="Research"
  description={siteProfile.description}
>
  <section class="section">
    <div class="container">
      <div class="page-hero">
        <div class="prose">
          <div class="eyebrow">Research Overview</div>
          <h1>Research Themes</h1>
          <p class="punchline hero-punch">
            Two linked lines of work: physical mechanism in idealized models, and process diagnosis in global storm-resolving models.
          </p>
          <p class="lead lead--wide">
            The structure of this page is intentional. Start with the topic that best matches your interest, then open the detailed page for context, media, and longer-form notes.
          </p>
        </div>

        <div class="page-hero-panel">
          <SectionHeader
            title="Reading Guide"
            subtitle="If you want physical mechanism, start with the idealized simulations. If you want model evaluation and interpretation, start with the GSRM diagnostics."
          />
        </div>
      </div>
    </div>
  </section>

  {projects.map((project, index) => (
    <section class={`section ${index % 2 === 0 ? "section--alt" : ""}`}>
      <div class="container">
        <ResearchRow
          index={index}
          title={project.data.title}
          short={project.data.short}
          summary={project.data.summary}
          media={project.data.media}
          cover={project.data.cover}
          video={project.data.video}
          fit={project.data.fit}
          ratio={project.data.ratio}
          href={`/research/${project.id}`}
        />
      </div>
    </section>
  ))}
</BaseLayout>
